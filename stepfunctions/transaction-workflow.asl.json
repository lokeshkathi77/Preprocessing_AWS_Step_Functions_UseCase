{
  "Comment": "Reference definition. CloudFormation injects deployment values.",
  "StartAt": "CheckEC2",
  "States": {
    "CheckEC2": {
      "Type": "Task",
      "Resource": "aws-sdk:ec2:describeInstances",
      "Next": "EC2Running?"
    },
    "EC2Running?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ec2Description.Reservations[0].Instances[0].State.Name",
          "StringEquals": "running",
          "Next": "RunECSTask"
        }
      ],
      "Default": "StartEC2"
    },
    "StartEC2": {
      "Type": "Task",
      "Resource": "aws-sdk:ec2:startInstances",
      "Next": "WaitForEC2"
    },
    "WaitForEC2": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "CheckEC2"
    },
    "RunECSTask": {
      "Type": "Task",
      "Resource": "ecs:runTask.sync",
      "End": true
    }
  }
}
